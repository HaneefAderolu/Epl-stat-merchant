# Free key, no credit card required: https://console.groq.com -> API Keys
GROQ_API_KEY=gsk_your-key-here

# Optional — defaults shown below. Groq retires/renames free-tier models periodically
# (they emailed a deprecation notice for the previous default of this project,
# llama-3.3-70b-versatile, on 2026-08-16) — if this app starts erroring with
# "model_not_found" or "model_decommissioned" again in future, check
# https://console.groq.com/docs/models for the current list and set EPL_MODEL here
# to override without touching code.
EPL_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
